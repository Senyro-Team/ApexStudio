{
  "name": "apex-studio",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "apps/erlcx-extension"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @apex/desktop",
    "desktop": "npm run tauri --workspace @apex/desktop -- dev",
    "build": "npm run build --workspace @apex/desktop",
    "build:windows-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-installer.ps1",
    "test": "npm run test --workspace @apex/desktop",
    "typecheck": "npm run typecheck --workspace @apex/desktop",
    "build:extension": "npm run build --workspace @apex/erlcx-extension"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
