APEX_SERVER_DOMAIN=sync.example.org
APEX_SYNC_DB_PASSWORD=replace-with-a-64-character-hex-secret
APEX_SYNC_BOOTSTRAP_TOKEN=
# Optional service gateways. Keep service keys only in this server's environment.
APEX_IMAGE_PROVIDER_URL=
APEX_IMAGE_PROVIDER_KEY=
# Optional Invite Tracker gateway. Use the same service key configured on Invite Tracker.
APEX_INVITE_TRACKER_URL=
APEX_INVITE_TRACKER_KEY=
# Maximum stored blob data (default: 8 GiB).
APEX_SYNC_MAX_BLOB_STORAGE_BYTES=8589934592
