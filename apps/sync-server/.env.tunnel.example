# Copy to .env.tunnel. Never commit the populated file.
# Use exactly 64 random hexadecimal characters (safe in the database URL).
APEX_SYNC_DB_PASSWORD=
# Maximum stored blob data (default: 8 GiB).
APEX_SYNC_MAX_BLOB_STORAGE_BYTES=8589934592
# Remove this after the first administrator account has been created.
APEX_SYNC_BOOTSTRAP_TOKEN=
# Optional service gateways. Leave both values blank to disable each service.
APEX_IMAGE_PROVIDER_URL=
APEX_IMAGE_PROVIDER_KEY=
# Optional Invite Tracker gateway. Use the same service key configured on Invite Tracker.
APEX_INVITE_TRACKER_URL=
APEX_INVITE_TRACKER_KEY=
# Connector token from your remotely managed Cloudflare Tunnel, not an API token.
CLOUDFLARE_TUNNEL_TOKEN=
